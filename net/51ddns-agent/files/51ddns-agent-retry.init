#!/bin/sh /etc/rc.common
# Copyright 2026 51DDNS
# SPDX-License-Identifier: Apache-2.0

USE_PROCD=1

start_service() {
	local enabled configured_id
	enabled="$(uci -q get 51ddns.main.enabled 2> /dev/null || :)"
	case "$enabled" in
	1 | true | yes | on) ;;
	*) return 0 ;;
	esac
	/etc/init.d/51ddns-agent enabled > /dev/null 2>&1 || return 0
	if [ "$(uci -q get 51ddns.main.router_web)" = 1 ] &&
		[ -n "$(uci -q get 51ddns.main.router_web_direct_hostname)" ]; then
		procd_open_instance router-credential
		procd_set_param command /usr/libexec/51ddns-router-credential
		procd_set_param no_new_privs 1
		procd_close_instance
	fi
	configured_id="$(uci -q get 51ddns.main.device_id 2> /dev/null || :)"
	[ -n "$configured_id" ] || [ -s /etc/51ddns/device.id ] || return 0
	/etc/init.d/51ddns-agent running > /dev/null 2>&1 && return 0

	procd_open_instance identity-retry
	procd_set_param command /usr/libexec/51ddns-agent-retry
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param no_new_privs 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 51ddns
}
